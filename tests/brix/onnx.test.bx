import test
import onnx
import json

// tests/integration/models/multi.onnx (make_models.py): inputs x [batch, 3],
// y [1, 3], scale []; outputs sum, scaled [batch, 3].

test.describe("ONNXModel inspection (v2.2 Grupo A Fase 1)", () -> {
    test.it("counts inputs and outputs", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.num_inputs()).toBe(3)
        test.expect(m.num_outputs()).toBe(2)
    })

    test.it("names inputs and outputs in model order", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.input_name(0)).toBe("x")
        test.expect(m.input_name(2)).toBe("scale")
        test.expect(m.output_name(1)).toBe("scaled")
    })

    test.it("reports shapes with -1 for a dynamic dimension", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var x := m.input_shape(0)
        test.expect(x).toHaveLength(2)
        test.expect(x[0]).toBe(-1)
        test.expect(x[1]).toBe(3)
        test.expect(m.input_shape(1)).toEqual([1, 3])
        test.expect(m.output_shape(1)).toContain(3)
    })

    test.it("a scalar input has rank 0", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.input_shape(2)).toHaveLength(0)
    })
})

test.describe("ONNXModel inference (v2.2 Grupo A Fase 2)", () -> {
    test.it("infer returns the first output", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var out := m.infer([1.0, 2.0, 3.0], [10, 20, 30], [2.0])
        test.expect(out).toEqual([11.0, 22.0, 33.0])
    })

    test.it("infer_output picks an output by name or index", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var by_name := m.infer_output("scaled", [1.0, 2.0, 3.0], [1.0, 1.0, 1.0], [0.5])
        var by_index := m.infer_output(1, [1.0, 2.0, 3.0], [1.0, 1.0, 1.0], [0.5])
        test.expect(by_name).toEqual([1.0, 1.5, 2.0])
        test.expect(by_index).toEqual(by_name)
    })

    test.it("the batch dimension follows the input rows", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var x := zeros(4, 3)
        var out := m.infer(x, [1.0, 2.0, 3.0], [1.0])
        test.expect(out.rows).toBe(4)
        test.expect(out.cols).toBe(3)
        test.expect(out[11]).toBeCloseTo(3.0)
    })

    test.it("converts int64 inputs and rank-3 outputs", () -> {
        var m := onnx.load("tests/integration/models/typed.onnx")
        var out := m.infer_output("trunc", [-1, 2, 3, 4, 5, 6], [2.5])
        test.expect(out.rows).toBe(1)
        test.expect(out.cols).toBe(6)
        test.expect(out).toEqual([0.0, 5.0, 7.0, 10.0, 12.0, 15.0])
    })
})

// tests/integration/models/fixed.onnx: x [2, 2, 2] (a fixed batch of 2);
// outputs sq = x * x, neg = -x.
test.describe("ONNXModel batch inference (v2.2 Grupo A Fase 3)", () -> {
    test.it("runs a fixed-batch model over any number of rows", () -> {
        var m := onnx.load("tests/integration/models/fixed.onnx")
        var batch := zeros(3, 4)
        batch[8] = 3.0
        var out := m.batch_infer(batch)
        test.expect(out.rows).toBe(3)
        test.expect(out.cols).toBe(4)
        test.expect(out[8]).toBeCloseTo(9.0)
    })

    test.it("matches infer on a dynamic batch dimension", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var x := zeros(2, 3)
        x[4] = 5.0
        var batched := m.batch_infer_output("scaled", x, [1.0, 1.0, 1.0], [3.0])
        test.expect(batched).toEqual(m.infer_output("scaled", x, [1.0, 1.0, 1.0], [3.0]))
    })

    test.it("an empty batch returns an empty matrix", () -> {
        var m := onnx.load("tests/integration/models/fixed.onnx")
        var out := m.batch_infer_output("neg", zeros(0, 4))
        test.expect(out.rows).toBe(0)
    })
})

test.describe("ONNXModel graceful errors (v2.2 Grupo A Fase 4)", () -> {
    test.it("try_load reports a missing model instead of aborting", () -> {
        var m := onnx.try_load("tests/integration/models/nope.onnx")
        test.expect(m.last_error()).toContain("File doesn't exist")
        test.expect(m.num_inputs()).toBe(0)
    })

    test.it("a failed inference returns an empty matrix and keeps the model usable", () -> {
        var m := onnx.try_load("tests/integration/models/multi.onnx")
        var bad := m.infer([1.0, 2.0, 3.0])
        test.expect(bad.rows).toBe(0)
        test.expect(m.last_error()).toStartWith("ONNXModel.infer: the model takes 3 input(s)")
        var ok := m.infer([1.0, 2.0, 3.0], [1.0, 1.0, 1.0], [1.0])
        test.expect(ok).toEqual([2.0, 3.0, 4.0])
        test.expect(m.last_error()).toBe("")
    })

    test.it("inspection errors return empty values", () -> {
        var m := onnx.try_load("tests/integration/models/multi.onnx")
        test.expect(m.output_name(5)).toBe("")
        test.expect(m.last_error()).toBe("ONNXModel.output_name(5): index out of range (2 outputs)")
        test.expect(m.input_shape(-1)).toHaveLength(0)
    })
})

test.describe("ONNXModel devices (v2.2 Grupo B Fase 2)", () -> {
    test.it("metal gives the same results as the CPU", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx", "metal")
        test.expect(m.device()).not.toBe("")
        var out := m.infer([1.0, 2.0, 3.0], [1.0, 1.0, 1.0], [2.0])
        test.expect(out).toEqual([2.0, 3.0, 4.0])
        test.expect(m.infer_output("scaled", [1.0, 2.0, 3.0], [1.0, 1.0, 1.0], [2.0])).toEqual([4.0, 6.0, 8.0])
        test.expect(onnx.load("tests/integration/models/multi.onnx").device()).toBe("cpu")
    })

    test.it("an unknown device is an error of try_load", () -> {
        var m := onnx.try_load("tests/integration/models/multi.onnx", "npu")
        test.expect(m.last_error()).toContain("unknown device \"npu\"")
        test.expect(m.device()).toBe("cpu")
    })
})

test.describe("onnx.available_devices (v2.2 Grupo B Fase 3)", () -> {
    test.it("lists the CPU last, after any GPU", () -> {
        var devices := onnx.available_devices()
        var n := json.array_len(devices)
        test.expect(n).toBeGreaterThan(0)
        var last := devices[n - 1]
        test.expect(json.as_string(last["type"]) ?: "").toBe("cpu")
    })
})
