import test
import onnx

// tests/integration/models/multi.onnx (make_models.py): inputs x [batch, 3],
// y [1, 3], scale []; outputs sum, scaled [batch, 3].

test.describe("ONNXModel inspection (v2.2 Grupo A Fase 1)", () -> {
    test.it("counts inputs and outputs", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.num_inputs()).toBe(3)
        test.expect(m.num_outputs()).toBe(2)
    })

    test.it("names inputs and outputs in model order", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.input_name(0)).toBe("x")
        test.expect(m.input_name(2)).toBe("scale")
        test.expect(m.output_name(1)).toBe("scaled")
    })

    test.it("reports shapes with -1 for a dynamic dimension", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        var x := m.input_shape(0)
        test.expect(x).toHaveLength(2)
        test.expect(x[0]).toBe(-1)
        test.expect(x[1]).toBe(3)
        test.expect(m.input_shape(1)).toEqual([1, 3])
        test.expect(m.output_shape(1)).toContain(3)
    })

    test.it("a scalar input has rank 0", () -> {
        var m := onnx.load("tests/integration/models/multi.onnx")
        test.expect(m.input_shape(2)).toHaveLength(0)
    })
})
