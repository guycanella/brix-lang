import test

// v2.0 Grupo A Fase 1: Embedding<DIM> construction + .to_matrix() conversions.
// println(embedding) is out of scope this phase (same gap Vector<T> already
// has), so values are always validated via .to_matrix() + indexing.
// Compile-time error paths (E104 literal-length mismatch, E102 wrong
// argument type, dimension zero) are pinned as integration/codegen unit
// tests, not here — Test Library runs already-compiled programs.

test.describe("Embedding<DIM> construction (v2.0 Grupo A Fase 1)", () -> {
    test.it("constructs from a float array literal", () -> {
        var e := Embedding<3>([1.0, 2.0, 3.0])
        var m := e.to_matrix()
        test.expect(m[0]).toBeCloseTo(1.0)
        test.expect(m[1]).toBeCloseTo(2.0)
        test.expect(m[2]).toBeCloseTo(3.0)
    })

    test.it("constructs from an int array literal via promotion", () -> {
        var e := Embedding<4>([1, 2, 3, 4])
        var m := e.to_matrix()
        test.expect(m[0]).toBeCloseTo(1.0)
        test.expect(m[3]).toBeCloseTo(4.0)
    })

    test.it("constructs from a correctly-shaped Matrix variable", () -> {
        var src := [5.0, 6.0, 7.0]
        var e := Embedding<3>(src)
        var m := e.to_matrix()
        test.expect(m[0]).toBeCloseTo(5.0)
        test.expect(m[2]).toBeCloseTo(7.0)
    })
})

test.describe("Embedding<DIM> ARC (v2.0 Grupo A Fase 1)", () -> {
    test.it("keeps an alias's value independent after reassignment", () -> {
        var a := Embedding<2>([1.0, 1.0])
        var b := a
        a = Embedding<2>([9.0, 9.0])
        test.expect(b.to_matrix()[0]).toBeCloseTo(1.0)
        test.expect(a.to_matrix()[0]).toBeCloseTo(9.0)
    })

    test.it("survives a block-scoped variable going out of scope", () -> {
        var outer := Embedding<2>([2.0, 3.0])
        if true {
            var scoped := Embedding<2>([100.0, 200.0])
            test.expect(scoped.to_matrix()[0]).toBeCloseTo(100.0)
        }
        test.expect(outer.to_matrix()[1]).toBeCloseTo(3.0)
    })
})

// v2.0 Grupo A Fase 2: similarity methods via BLAS (ddot_ / dnrm2_).
// Dimension mismatch is a compile-time E102, pinned in codegen unit tests.
test.describe("Embedding<DIM> similarity (v2.0 Grupo A Fase 2)", () -> {
    test.it("dot_product sums element-wise products", () -> {
        var a := Embedding<3>([1.0, 2.0, 3.0])
        var b := Embedding<3>([4.0, 5.0, 6.0])
        test.expect(a.dot_product(b)).toBeCloseTo(32.0)
    })

    test.it("euclidean_distance is the L2 norm of the difference", () -> {
        var a := Embedding<2>([1.0, 1.0])
        var b := Embedding<2>([4.0, 5.0])
        test.expect(a.euclidean_distance(b)).toBeCloseTo(5.0)
    })

    test.it("cosine_similarity of parallel vectors is 1", () -> {
        var a := Embedding<3>([1.0, 2.0, 3.0])
        var b := Embedding<3>([3.0, 6.0, 9.0])
        test.expect(a.cosine_similarity(b)).toBeCloseTo(1.0)
    })

    test.it("cosine_similarity with a zero vector is 0, not NaN", () -> {
        var a := Embedding<2>([1.0, 2.0])
        var z := Embedding<2>([0.0, 0.0])
        test.expect(a.cosine_similarity(z)).toBe(0.0)
    })

    test.it("all three methods are symmetric", () -> {
        var a := Embedding<3>([0.5, -1.0, 2.0])
        var b := Embedding<3>([3.0, 1.5, -0.25])
        test.expect(a.dot_product(b)).toBeCloseTo(b.dot_product(a))
        test.expect(a.euclidean_distance(b)).toBeCloseTo(b.euclidean_distance(a))
        test.expect(a.cosine_similarity(b)).toBeCloseTo(b.cosine_similarity(a))
    })

    test.it("accepts an inline temporary argument", () -> {
        var a := Embedding<3>([1.0, 2.0, 3.0])
        test.expect(a.dot_product(Embedding<3>([1, 1, 1]))).toBeCloseTo(6.0)
        test.expect(a.to_matrix()[2]).toBeCloseTo(3.0)
    })

    test.it("works through a ternary receiver and aliasing", () -> {
        var a := Embedding<2>([1.0, 0.0])
        var b := Embedding<2>([0.0, 1.0])
        var f := 1
        test.expect((f > 0 ? a : b).dot_product(a)).toBeCloseTo(1.0)
        var c := f > 0 ? b : a
        test.expect(c.dot_product(b)).toBeCloseTo(1.0)
        test.expect(a.dot_product(a)).toBeCloseTo(1.0)
    })
})

test.describe("EmbeddingBatch<DIM> (v2.0 Grupo A Fase 3)", () -> {
    test.it("starts empty and grows from capacity 0", () -> {
        var b := EmbeddingBatch<3>(0)
        test.expect(b.len()).toBe(0)
        test.expect(b.is_empty()).toBeTruthy()
        var i := 0
        while i < 6 {
            b.add(Embedding<3>([1.0, 0.0, 0.0]))
            i = i + 1
        }
        test.expect(b.len()).toBe(6)
        test.expect(b.is_empty()).toBeFalsy()
    })

    test.it("get returns the embedding at its insertion index", () -> {
        var b := EmbeddingBatch<2>(4)
        b.add(Embedding<2>([1.0, 2.0]))
        b.add(Embedding<2>([3.0, 4.0]))
        test.expect(b.get(1).to_matrix()[0]).toBeCloseTo(3.0)
        test.expect(b.get(0).to_matrix()[1]).toBeCloseTo(2.0)
    })

    test.it("shares ownership: the source and the batch outlive each other", () -> {
        var b := EmbeddingBatch<2>(1)
        var e := Embedding<2>([3.0, 4.0])
        b.add(e)
        e = Embedding<2>([0.0, 0.0])
        test.expect(b.get(0).dot_product(b.get(0))).toBeCloseTo(25.0)
        var kept := b.get(0)
        b = EmbeddingBatch<2>(0)
        test.expect(kept.euclidean_distance(Embedding<2>([0.0, 0.0]))).toBeCloseTo(5.0)
    })

    test.it("find_nearest returns indices sorted by cosine similarity", () -> {
        var b := EmbeddingBatch<2>(0)
        b.add(Embedding<2>([0.0, 1.0]))
        b.add(Embedding<2>([1.0, 0.0]))
        b.add(Embedding<2>([1.0, 1.0]))
        var r := b.find_nearest(Embedding<2>([1.0, 0.2]), 2)
        test.expect(r).toHaveLength(2)
        test.expect(r[0]).toBe(1)
        test.expect(r[1]).toBe(2)
    })

    test.it("find_nearest clamps k: k == 0, k > len, empty batch", () -> {
        var b := EmbeddingBatch<2>(0)
        var q := Embedding<2>([1.0, 0.0])
        test.expect(b.find_nearest(q, 3)).toHaveLength(0)
        b.add(Embedding<2>([1.0, 0.0]))
        b.add(Embedding<2>([0.0, 1.0]))
        test.expect(b.find_nearest(q, 0)).toHaveLength(0)
        test.expect(b.find_nearest(q, 5)).toHaveLength(2)
    })

    test.it("get combined with find_nearest materializes the nearest embedding", () -> {
        var b := EmbeddingBatch<3>(2)
        b.add(Embedding<3>([1.0, 0.0, 0.0]))
        b.add(Embedding<3>([0.0, 0.0, 1.0]))
        b.add(Embedding<3>([0.0, 1.0, 0.0]))
        var q := Embedding<3>([0.1, 0.2, 0.9])
        var nearest := b.get(b.find_nearest(q, 1)[0])
        test.expect(nearest.cosine_similarity(Embedding<3>([0.0, 0.0, 1.0]))).toBeCloseTo(1.0)
    })
})
