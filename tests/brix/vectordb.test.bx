import test
import vectordb
import json

// Offline only: the request/response paths against a (mock) Pinecone host
// are covered by integration tests 274-275.
test.describe("env() (v2.1 Grupo A)", () -> {
    test.it("returns the value of a set variable", () -> {
        var path := env("PATH") ?: ""
        test.expect(path.len > 0).toBeTruthy()
    })

    test.it("returns nil for an unset variable", () -> {
        test.expect(env("BRIX_TEST_SURELY_UNSET_VAR_42")).toBeNil()
    })
})

test.describe("VectorDB connection (v2.1 Grupo A Fase 1)", () -> {
    test.it("connect returns a VectorDB without network I/O", () -> {
        var db := vectordb.connect("pinecone", "my-index.svc.pinecone.io", "key", "prod")
        test.expect(typeof(db)).toBe("VectorDB")
        test.expect(db.last_error()).toBe("")
    })

    test.it("a refused connection returns nil and sets last_error", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.stats()).toBeNil()
        test.expect(db.last_error()).toStartWith("/describe_index_stats: ")
    })

    test.it("last_error never contains the API key", () -> {
        var db := vectordb.connect("pinecone", "http://localhost:1", "sk-super-secret")
        test.expect(db.stats()).toBeNil()
        test.expect(db.last_error().contains("sk-super-secret")).toBeFalsy()
    })
})

test.describe("VectorDB query / fetch / list (v2.1 Grupo A Fase 2)", () -> {
    test.it("query on a refused connection returns nil", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.query(Embedding<3>([1.0, 0.0, 0.0]), 3)).toBeNil()
        test.expect(db.last_error()).toStartWith("/query: ")
    })

    test.it("query rejects top_k < 1 without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.query(Embedding<2>([1.0, 0.0]), 0)).toBeNil()
        test.expect(db.last_error()).toBe("/query: top_k must be >= 1, got 0")
    })

    test.it("query rejects NaN in the vector without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.query(Embedding<2>([0.0 / 0.0, 1.0]), 1)).toBeNil()
        test.expect(db.last_error()).toBe("/query: query vector contains NaN or Inf")
    })

    test.it("fetch on a refused connection returns nil with a reason", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.fetch("doc_1")).toBeNil()
        test.expect(db.last_error()).toStartWith("/vectors/fetch: ")
        test.expect(db.last_error().contains("doc_1")).toBeFalsy()
    })

    test.it("list rejects limit < 1 and fails offline", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.list(0)).toBeNil()
        test.expect(db.last_error()).toBe("/vectors/list: limit must be >= 1, got 0")
        test.expect(db.list(10, "tok")).toBeNil()
        test.expect(db.last_error()).toStartWith("/vectors/list: ")
    })
})

test.describe("VectorDB writes (v2.1 Grupo A Fase 3)", () -> {
    test.it("upsert on a refused connection returns 0", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.upsert("d1", Embedding<3>([1.0, 0.0, 0.0]))).toBe(0)
        test.expect(db.last_error()).toStartWith("/vectors/upsert: ")
    })

    test.it("upsert rejects NaN and non-object metadata without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.upsert("d1", Embedding<2>([0.0 / 0.0, 1.0]))).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: vector contains NaN or Inf")
        test.expect(db.upsert("d1", Embedding<2>([1.0, 1.0]), json.parse("3"))).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: metadata must be a JSON object")
    })

    test.it("upsert_batch checks lengths without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        var ids := Vector<string>()
        ids.push("a")
        var vs := EmbeddingBatch<2>(1)
        test.expect(db.upsert_batch(ids, vs)).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: 1 ids but 0 embeddings")
        vs.add(Embedding<2>([1.0, 0.0]))
        test.expect(db.upsert_batch(ids, vs, json.array())).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: metadata must be a JSON array with one entry per id")
    })

    test.it("empty batches succeed without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.upsert_batch(Vector<string>(), EmbeddingBatch<2>(0))).toBe(1)
        test.expect(db.delete_batch(Vector<string>())).toBe(1)
        test.expect(db.last_error()).toBe("")
    })

    test.it("a record over the request limit is rejected without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        var meta := json.object()
        json.set(meta, "pad", json.string("x".repeat(2100000)))
        test.expect(db.upsert("big", Embedding<2>([1.0, 0.0]), meta)).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: larger than the 2000000-byte request limit")
    })

    test.it("empty ids are rejected without a request", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.upsert("", Embedding<2>([1.0, 0.0]))).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: id must be a non-empty string")
        var ids := Vector<string>()
        ids.push("a")
        ids.push("")
        var vs := EmbeddingBatch<2>(2)
        vs.add(Embedding<2>([1.0, 0.0]))
        vs.add(Embedding<2>([0.0, 1.0]))
        test.expect(db.upsert_batch(ids, vs)).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/upsert: record 1: id must be a non-empty string")
        test.expect(db.delete("")).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/delete: id must be a non-empty string")
        test.expect(db.delete_batch(ids)).toBe(0)
        test.expect(db.last_error()).toBe("/vectors/delete: record 1: id must be a non-empty string")
    })

    test.it("delete on a refused connection returns 0", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.delete("d1")).toBe(0)
        test.expect(db.last_error()).toStartWith("/vectors/delete: ")
    })
})

test.describe("VectorDB index management (v2.1 Grupo A Fase 4)", () -> {
    test.it("delete_namespace on a refused connection returns 0", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.delete_namespace("prod")).toBe(0)
        test.expect(db.last_error()).toStartWith("/vectors/delete: ")
    })

    test.it("reset_index stops at the stats request when offline", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.reset_index()).toBe(0)
        test.expect(db.last_error()).toStartWith("/describe_index_stats: ")
    })
})

test.describe("VectorDB settings (v2.1 Grupo A Fase 5)", () -> {
    test.it("last_status is 0 without a response", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.last_status()).toBe(0)
        test.expect(db.stats()).toBeNil()
        test.expect(db.last_status()).toBe(0)
    })

    test.it("set_timeout and set_retries validate their argument", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.set_timeout(250)).toBe(1)
        test.expect(db.set_timeout(0)).toBe(0)
        test.expect(db.last_error()).toBe("set_timeout: ms must be >= 1, got 0")
        test.expect(db.set_retries(0)).toBe(1)
        test.expect(db.set_retries(10)).toBe(1)
        test.expect(db.set_retries(11)).toBe(0)
        test.expect(db.last_error()).toBe("set_retries: n must be between 0 and 10, got 11")
    })

    test.it("connection failures are not retried", () -> {
        var db := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        test.expect(db.set_retries(10)).toBe(1)
        test.expect(db.stats()).toBeNil()
        test.expect(db.last_error().contains("retries")).toBeFalsy()
    })
})

test.describe("VectorDB on Chroma (v2.1 Grupo B Fase 1)", () -> {
    test.it("namespaces are not supported, without a request", () -> {
        var db := vectordb.connect("chroma", "http://127.0.0.1:1", "", "docs")
        test.expect(db.delete_namespace("x")).toBe(0)
        test.expect(db.last_error()).toBe("delete_namespace: not supported by chroma")
        test.expect(db.reset_index()).toBe(0)
        test.expect(db.last_error()).toBe("reset_index: not supported by chroma")
        test.expect(db.last_status()).toBe(0)
    })

    test.it("list checks its token locally", () -> {
        var db := vectordb.connect("chroma", "http://127.0.0.1:1", "", "docs")
        test.expect(db.list(2, "-1")).toBeNil()
        test.expect(db.last_error()).toBe("/get: invalid pagination token")
        test.expect(db.list(0)).toBeNil()
        test.expect(db.last_error()).toBe("/get: limit must be >= 1, got 0")
    })

    test.it("operations on a refused connection fail resolving the collection", () -> {
        var db := vectordb.connect("chroma", "http://127.0.0.1:1", "", "acme/prod/docs")
        test.expect(db.upsert("a", Embedding<3>([1.0, 0.0, 0.0]))).toBe(0)
        test.expect(db.last_error()).toStartWith("/collections/docs: ")
    })
})

test.describe("VectorDB on Weaviate (v2.1 Grupo B Fase 2)", () -> {
    test.it("namespaces are not supported, without a request", () -> {
        var db := vectordb.connect("weaviate", "http://127.0.0.1:1", "", "Docs")
        test.expect(db.delete_namespace("x")).toBe(0)
        test.expect(db.last_error()).toBe("delete_namespace: not supported by weaviate")
        test.expect(db.reset_index()).toBe(0)
        test.expect(db.last_error()).toBe("reset_index: not supported by weaviate")
    })

    test.it("local checks run before any request", () -> {
        var db := vectordb.connect("weaviate", "http://127.0.0.1:1", "", "Docs")
        test.expect(db.list(0)).toBeNil()
        test.expect(db.last_error()).toBe("/v1/objects: limit must be >= 1, got 0")
        test.expect(db.query(Embedding<3>([1.0, 0.0, 0.0]), 1, json.int(1))).toBeNil()
        test.expect(db.last_error()).toBe("/v1/graphql: filter must be a Weaviate where object")
        var m := json.object()
        json.set(m, "brix_id", json.string("x"))
        test.expect(db.upsert("a", Embedding<3>([1.0, 0.0, 0.0]), m)).toBe(0)
        test.expect(db.last_error()).toBe("/v1/batch/objects: metadata must not contain \"brix_id\" (it holds the id)")
    })

    test.it("operations on a refused connection fail resolving the class", () -> {
        var db := vectordb.connect("weaviate", "http://127.0.0.1:1", "", "Docs")
        test.expect(db.fetch("a")).toBeNil()
        test.expect(db.last_error()).toStartWith("/v1/schema/Docs: ")
        test.expect(db.last_status()).toBe(0)
    })
})

test.describe("VectorDB empty batches (v2.1 Grupo B Fase 2)", () -> {
    test.it("succeed without a request on every provider", () -> {
        var ids := Vector<string>()
        var vecs := EmbeddingBatch<3>(0)
        var pc := vectordb.connect("pinecone", "http://127.0.0.1:1", "key")
        var ch := vectordb.connect("chroma", "http://127.0.0.1:1", "", "docs")
        var wv := vectordb.connect("weaviate", "http://127.0.0.1:1", "", "Docs")
        test.expect(pc.upsert_batch(ids, vecs)).toBe(1)
        test.expect(pc.delete_batch(ids)).toBe(1)
        test.expect(ch.upsert_batch(ids, vecs)).toBe(1)
        test.expect(ch.delete_batch(ids)).toBe(1)
        test.expect(wv.upsert_batch(ids, vecs)).toBe(1)
        test.expect(wv.delete_batch(ids)).toBe(1)
        var mv := vectordb.connect("milvus", "http://127.0.0.1:1", "", "docs")
        test.expect(mv.upsert_batch(ids, vecs)).toBe(1)
        test.expect(mv.delete_batch(ids)).toBe(1)
    })
})

test.describe("VectorDB on Milvus (v2.1 Grupo B Fase 3)", () -> {
    test.it("namespaces are not supported, without a request", () -> {
        var db := vectordb.connect("milvus", "http://127.0.0.1:1", "", "docs")
        test.expect(db.delete_namespace("x")).toBe(0)
        test.expect(db.last_error()).toBe("delete_namespace: not supported by milvus")
        test.expect(db.reset_index()).toBe(0)
        test.expect(db.last_error()).toBe("reset_index: not supported by milvus")
    })

    test.it("local checks run before any request", () -> {
        var db := vectordb.connect("milvus", "http://127.0.0.1:1", "", "prod/docs")
        test.expect(db.list(0)).toBeNil()
        test.expect(db.last_error()).toBe("/v2/vectordb/entities/query: limit must be >= 1, got 0")
        test.expect(db.query(Embedding<3>([1.0, 0.0, 0.0]), 1, json.object())).toBeNil()
        test.expect(db.last_error()).toBe("/v2/vectordb/entities/search: filter must be a Milvus filter expression (a JSON string)")
    })

    test.it("operations on a refused connection fail describing the collection", () -> {
        var db := vectordb.connect("milvus", "http://127.0.0.1:1", "", "docs")
        test.expect(db.fetch("a")).toBeNil()
        test.expect(db.last_error()).toStartWith("/v2/vectordb/collections/describe: ")
        test.expect(db.last_status()).toBe(0)
    })
})
