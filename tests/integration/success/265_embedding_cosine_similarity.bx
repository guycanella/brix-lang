// v2.0 Grupo A Fase 2: Embedding.cosine_similarity() via BLAS ddot_ + dnrm2_.
var a := Embedding<3>([1.0, 2.0, 3.0])
var b := Embedding<3>([2.0, 4.0, 6.0])
println(a.cosine_similarity(b))

// Orthogonal -> 0
var x := Embedding<2>([1.0, 0.0])
var y := Embedding<2>([0.0, 5.0])
println(x.cosine_similarity(y))

// Opposite -> -1
var n := Embedding<2>([-1.0, 0.0])
println(x.cosine_similarity(n))

// Zero-vector contract: 0.0, never NaN
var z := Embedding<3>([0.0, 0.0, 0.0])
println(a.cosine_similarity(z))
println(z.cosine_similarity(z))
