// v2.2 Grupo A Fase 2: model.infer / model.infer_output on multi.onnx
// (inputs x [batch, 3], y [1, 3], scale []; outputs sum = x + y,
// scaled = sum * scale).
import onnx

var model := onnx.load("tests/integration/models/multi.onnx")
var x := zeros(2, 3)
for i in 0..<6 {
    x[i] = i + 1.0
}
var y := [10, 20, 30]

// infer returns output 0 (sum); the batch dimension follows x's rows; an
// int[] is promoted; a scalar input takes a 1-element matrix.
var sum := model.infer(x, y, [2.0])
println(sum)
println(f"{sum.rows}x{sum.cols}")

// infer_output picks an output by name or by index.
println(model.infer_output("scaled", x, y, [2.0]))
println(model.infer_output(1, [1.5, 2.5, 3.5], y, [0.5]))
var name := "sum"
println(model.infer_output(name, [1, 1, 1], y, [0.0]))

// The model is reused, also through a copy and a temporary receiver.
var copy := model
println(copy.infer([0.0, 0.0, 0.0], [1.0, 2.0, 3.0], [1.0]))
println(onnx.load("tests/integration/models/multi.onnx").infer_output(1, [1.0, 1.0, 1.0], y, [3.0]))
println(name)
println(x[5])
